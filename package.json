{
  "name": "softionyx-website",
  "version": "1.0.0",
  "description": "Professional website for SoftIonyx IT Company",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --exec ts-node src/server.ts",
    "dev:client": "cd client && npm run dev",
    "sitemap:generate": "node scripts/generate-sitemap.js",
    "rss:generate": "node scripts/generate-rss.js",
    "prebuild": "node scripts/generate-sitemap.js && node scripts/generate-rss.js",
    "build": "tsc && cd client && npm run build",
    "start": "node dist/server.js",
    "create-admin": "node scripts/create-admin.js",
    "create-user": "node scripts/create-user.js",
    "create-default-admin": "node scripts/create-default-admin.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:status": "node scripts/migrate.js --status",
    "db:init": "node scripts/migrate.js --init",
    "optimize:images": "node scripts/optimize-images.js",
    "og:generate": "node scripts/generate-og-image.js",
    "favicons:generate": "node scripts/generate-favicons.js",
    "prerender": "node scripts/prerender.js",
    "build:static": "npm run build && npm run prerender"
  },
  "keywords": [
    "website",
    "it-company",
    "softionyx"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "geoip-lite": "^2.0.1",
    "helmet": "^7.1.0",
    "i18next": "^25.8.0",
    "i18next-fs-backend": "^2.6.1",
    "i18next-http-middleware": "^3.9.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "puppeteer": "^24.42.0",
    "sharp": "^0.34.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
