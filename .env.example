# ──────────────────────────────────────────────────────────────────────────
# SoftIonyx — example environment
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# Every variable consumed by the app is documented here; anything missing
# falls back to a safe default where possible.
# ──────────────────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=softionyx
DB_USER=postgres
DB_PASSWORD=

# ─── Auth / JWT ───────────────────────────────────────────────────────────
# Generate a strong random secret (minimum 32 chars):
#   openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters

# ─── Server ───────────────────────────────────────────────────────────────
# HOST controls which interface Express binds to. `0.0.0.0` exposes the
# server on every network interface — handy in Docker/VM setups. Default
# is loopback (`127.0.0.1`) which is safer for local dev.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Public URL used in email templates and links sent out.
BASE_URL=http://localhost:3000

# Canonical host used in <link rel="canonical">, sitemap.xml and robots.txt.
# Must match the final deployed domain (no trailing slash).
SEO_BASE_URL=https://softionyx.com

# ─── Analytics ────────────────────────────────────────────────────────────
# Salt used when hashing client IPs before storing them, so that raw IPs
# never touch the database. Change in production — the same value must be
# used across restarts or session attribution will break.
ANALYTICS_IP_SALT=change_me_to_a_long_random_string

# ─── Email (SMTP) ─────────────────────────────────────────────────────────
# Gmail note: use an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
CONTACT_EMAIL=your_contact_email@example.com

# ─── Logging ──────────────────────────────────────────────────────────────
# Winston level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# ─── Client (Vite) ────────────────────────────────────────────────────────
# These are read at build time by the client bundle. Variables MUST be
# prefixed with `VITE_` to be exposed to the browser.

# Override the API base URL when the client is hosted separately from the
# API (e.g. on a CDN). When empty, the client uses same-origin requests
# which work behind the Vite dev proxy and in production when Node serves
# the built SPA.
# VITE_API_URL=https://api.softionyx.com

# Google Maps Embed API key for the interactive map on /contact.
# https://console.cloud.google.com/ → Maps Embed API
# VITE_GOOGLE_MAPS_EMBED_KEY=your_key_here

# Spline scene URL used as the hero 3D background (desktop-only). Leaving
# this unset disables the Spline background entirely.
# VITE_SPLINE_SCENE_URL=https://prod.spline.design/.../scene.splinecode
